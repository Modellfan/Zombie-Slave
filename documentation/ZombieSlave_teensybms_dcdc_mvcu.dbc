CM_ BO_ 528 "RX by ZombieSlave TeslaDCDC::DecodeCAN(), registered as 0x210. Status timeout is 1000 ms in firmware.";
CM_ BO_ 984 "TX by ZombieSlave TeslaDCDC::Task100Ms() every 500 ms. Voltage command is raw=(setpoint_V-9)*146, clamped to 9..16 V.";
CM_ BO_ 1050 "RX by TeensyBMS::parseMsg1(), registered as 0x41A. Byte 7 is STM32 CRC low byte over bytes 0..6.";
CM_ BO_ 1051 "RX by TeensyBMS::parseMsg2(), registered as 0x41B. Byte 7 is STM32 CRC low byte over bytes 0..6.";
CM_ BO_ 1052 "RX by TeensyBMS::parseMsg3(), registered as 0x41C. Byte 5 is BMS DTC flags in current firmware.";
CM_ BO_ 1053 "RX by TeensyBMS::parseMsg4(), registered as 0x41D. BalancingActive is derived from BalancingStatus == 1.";
CM_ BO_ 1054 "RX by TeensyBMS::parseMsg5(), registered as 0x41E. AverageEnergyPerHour is signed little-endian int16 scaled by 0.01 kW.";
CM_ BO_ 1079 "TX by ZombieSlave TeensyBMS::Task100Ms() every 100 ms. Byte 7 is STM32 CRC low byte over bytes 0..6.";
CM_ BO_ 1080 "TX by ZombieSlave mVCUIntegration::Task100Ms() every 100 ms. Actual power is DC charge power plus charger loss power, clipped at zero.";
CM_ BO_ 1081 "TX by ZombieSlave mVCUIntegration::Task100Ms() every 100 ms. Byte 7 is STM32 CRC low byte over bytes 0..6.";
CM_ BO_ 1082 "RX by ZombieSlave mVCUIntegration::DecodeCAN(), registered as 0x43A. Requires DLC 8, valid CRC, and sequential 4-bit counter; request times out after 500 ms.";

CM_ SG_ 528 DCDC_CoolantTemperature "Firmware decodes byte 2 as signed int8, then coolantTemp_degC = raw * 0.5 + 40.";
CM_ SG_ 1051 BMS_PackPower "Firmware decodes bytes 4..5 as unsigned raw kW with factor 0.01 and offset -300, then stores W.";
CM_ SG_ 1080 mVCU_ActualChargePower "Source: (mlb_chr_LAD_IstSpannung_HV * mlb_chr_LAD_IstStrom_HV) + mlb_chr_LAD_Verlustleistung.";
CM_ SG_ 1080 mVCU_MaxChargePower "Source: mlb_chr_HVLM_MaxLadeLeistung.";

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 100000;
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_ "GenMsgCycleTime" BO_ 984 500;
BA_ "GenMsgCycleTime" BO_ 1079 100;
BA_ "GenMsgCycleTime" BO_ 1080 100;
BA_ "GenMsgCycleTime" BO_ 1081 100;

